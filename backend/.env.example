# Acumen — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM ──────────────────────────────────────────────────────────────────────
# Required for OpenAI embeddings + GPT-4o chat (wiki_swarm & action_agent)
OPENAI_API_KEY=sk-...

# ── Optional: Groq (faster, free-tier friendly) ───────────────────────────────
# GROQ_API_KEY=gsk_...

# ── Optional: Audio / TTS ────────────────────────────────────────────────────
# Required for Podcast generation (espnet/kan-bayashi_ljspeech_vits)
HUGGINGFACE_API_KEY=hf_...

# ── Server ───────────────────────────────────────────────────────────────────
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
