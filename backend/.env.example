# 💎 Acumen — Backend Configuration Template
# Copy this file to .env and configure it for your environment.

# ==============================================================================
# 🚨 REQUIRED CONFIGURATION (Application will not run without these)
# ==============================================================================

# 🧬 Google Gemini API Key
# Required for topic synthesis (wiki_swarm) and Action Agent chat.
# Obtain from Google AI Studio: https://aistudio.google.com/
GOOGLE_API_KEY=AIzaSy...

# 🔐 Clerk Authentication Keys
# Required for verifying Next.js user tokens.
# Obtain from your Clerk Dashboard: https://dashboard.clerk.com/
CLERK_SECRET_KEY=sk_test_...


# ==============================================================================
# ⚙️ OPTIONAL CONFIGURATION (Customise performance & paths)
# ==============================================================================

# 🌍 Application Environment
# Options: development | staging | production
# Setting to production disables ACUMEN_AUTH_BYPASS for safety.
ENVIRONMENT=development

# 🛡️ Development Authentication Bypass
# Set to 'true' to allow access to authenticated endpoints with a dummy user
# for offline or quick local development. (Ignored if ENVIRONMENT=production).
ACUMEN_AUTH_BYPASS=false

# 🌍 CORS Allowed Origins
# Comma-separated list of origins allowed to request this API.
# Defaults to http://localhost:3000,http://127.0.0.1:3000 for standard Next.js dev server.
# Set to '*' to allow all (disables credentialed cookies/auth).
ACUMEN_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# 🧠 LLM Model Selection
# The Google Gemini model used by the action agent and wikiswarm.
# Defaults to gemini-2.5-flash (fast, cheap, highly capable).
ACUMEN_LLM_MODEL=gemini-2.5-flash

# 📂 Persistent Data Directory
# Directory where SQLite acumen.db and Chroma DB vectors will be saved.
# Defaults to ./data in the current working directory.
ACUMEN_DATA_DIR=./data

# 🔗 Optional Clerk JWKS URL Override
# Reconstructs from Clerk Secret Key well-known endpoint by default.
# CLERK_JWKS_URL=https://<your-frontend-api>.clerk.accounts.dev/.well-known/jwks.json

# 🎙️ Optional Hugging Face API Key
# Used for serverless text-to-speech inference (Inference API).
# Obtain from Hugging Face: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_...

# 🖥️ Server Binding
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
